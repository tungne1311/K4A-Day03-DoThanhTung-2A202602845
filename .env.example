# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# LUU Y: 'gemini-2.5-flash' khong con cap cho tai khoan moi (API tra ve 404).
# Model da duoc nghiem thu thuc te cho bai lab nay:
LLM_MODEL=gemini-flash-lite-latest
# LLM_MODEL=gemini-3.6-flash      # Ban day du hon, nhung Free Tier chi 5 request/phut

# So lan tu dong thu lai khi cham han muc Free Tier (loi 429)
MAX_API_RETRIES=4

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
